# Источник переменных переехал: используйте deploy/k8s/config/.env(.example).
# Этот файл оставлен для обратной совместимости с локальными сценариями.
#
# Docker Hub — make registry-dockerhub / secret-config-riid (профиль по умолчанию)
RIID_DOCKERHUB_USER=
RIID_DOCKERHUB_TOKEN=
#
# Selectel Container Registry — make registry-selectel
RIID_SELECTEL_USER=
RIID_SELECTEL_TOKEN=
