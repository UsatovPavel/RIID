# Скопируйте: cp deploy/k8s/riid/.env.example deploy/k8s/riid/.env
# deploy/k8s/riid/.env в .gitignore — не коммитьте.
#
# Docker Hub — make registry-dockerhub / secret-config-riid (профиль по умолчанию)
RIID_DOCKERHUB_USER=
RIID_DOCKERHUB_TOKEN=
#
# Selectel Container Registry — make registry-selectel
RIID_SELECTEL_USER=
RIID_SELECTEL_TOKEN=
