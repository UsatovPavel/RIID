# Генерация из kubeconfig-файла (имена полей OpenAPI):
#   ./sync-dotenv-from-serverconfig.sh [serverConfig.yaml] [.env]
K8S_CA_DATA=BASE64_CA_CERT
K8S_CLIENT_CERT_DATA=BASE64_CLIENT_CERT
K8S_CLIENT_KEY_DATA=BASE64_CLIENT_KEY

# Для make init-performance-registry-images (зеркало 30 образов performance-тестов в CRaaS и т.п.):
# REGISTRY_USER=...
# REGISTRY_PASSWORD=...
# Дополнительные параметры:
# REGISTRY=UUID-реестра-из-панели   или   REGISTRY=cr.selcloud.ru/UUID
# REGISTRY_LOGIN_HOST=...  # только если REGISTRY без «/» и не Selectel (иначе не нужен)
# REGISTRY_PUSH_REPO_STRIP_LIBRARY=0  # по умолчанию на selcloud.ru=1 (см. init-performance-registry-images.sh)