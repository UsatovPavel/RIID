#cloud-config
# Воркер стенда: та же база, что у control plane, плюс Porto и вход в кластер.

# This image boots with cgroup2 as the sole unified hierarchy for
# memory/cpu/cpuset/blkio/pids (only a few controllers stay legacy-mounted
# alongside it). Porto 5.3.41 mounts its own cgroup v1 tree per controller and
# needs all of them as legacy, so on pure-unified it crash-loops forever:
# "Cannot mount cgroup: Device or resource busy" for each one, respawned by
# portod-master in a tight loop. The cgroup layout is fixed at kernel init, so
# this needs the systemd.unified_cgroup_hierarchy=0 boot param and a reboot
# before Porto ever starts. bootcmd runs on every boot; the /proc/cmdline
# check itself is what makes this idempotent across the reboot it triggers
# (no cloud-init-per: this image's cloud-init 21.3 doesn't ship that helper,
# it 127s). write_files/runcmd below (including the Porto install) haven't
# run yet at the point this fires, so they execute normally on the second
# boot with the fix already in place.
bootcmd:
  - [sh, -c, 'grep -q systemd.unified_cgroup_hierarchy=0 /proc/cmdline || { echo "GRUB_CMDLINE_LINUX_DEFAULT=\"$GRUB_CMDLINE_LINUX_DEFAULT systemd.unified_cgroup_hierarchy=0\"" >> /etc/default/grub; update-grub; reboot; }']

users:
  - default
  - name: riid
    gecos: RIID benchmark stand
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  - path: /opt/riid/common-node.sh
    permissions: "0755"
    content: |
      ${indent(6, common)}

  - path: /opt/riid/kubeadm-join.yaml
    permissions: "0600"
    content: |
      apiVersion: kubeadm.k8s.io/v1beta4
      kind: JoinConfiguration
      discovery:
        bootstrapToken:
          token: ${kubeadm_token}
          apiServerEndpoint: ${api_endpoint}
          # CA control plane появляется позже, чем рендерится этот файл, а
          # единственный вход в 6443 закрыт security group стенда.
          unsafeSkipCAVerification: true
      nodeRegistration:
        criSocket: unix:///run/containerd/containerd.sock
%{ if node_labels != "" ~}
        kubeletExtraArgs:
          - name: node-labels
            value: "${node_labels}"
%{ endif ~}

  # Пакет создаёт /etc/portod.conf.d и мержит оттуда *.conf по алфавиту, поэтому
  # настройка кладётся drop-in'ом и не спорит с файлом пакета. Написан до runcmd:
  # postinst сам стартует porto, конфиг должен быть на месте раньше.
  - path: /etc/portod.conf.d/10-riid-bench.conf
    permissions: "0644"
    content: |
      # docker_images_support выключен по умолчанию, а без него portoctl
      # docker-pull / docker-images / docker-rmi недоступны целиком — на них
      # держится арм Porto в performance/backend/engine/porto.inc.sh.
      container {
          docker_images_support: true
%{ for registry in porto_insecure ~}
          docker_insecure_registry: "${registry}"
%{ endfor ~}
      }

  - path: /opt/riid/bootstrap.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euxo pipefail
      /opt/riid/common-node.sh

      # Porto: релизный jammy-deb, а не сборка из исходников. Сборка тянет весь
      # build-depends и минуты времени на каждой ноде, а пакет ставит бинарники
      # в /usr/sbin и сам включает porto.service.
      curl -fsSLo /opt/riid/porto.deb \
        "https://github.com/ten-nancy/porto/releases/download/v${porto_version}/porto_jammy_${porto_version}_amd64.deb"
      apt-get install -y /opt/riid/porto.deb
      systemctl enable --now porto
      portoctl --version

      # control plane поднимается параллельно, поэтому ждём его API.
      for attempt in $(seq 1 120); do
        if timeout 3 bash -c "cat < /dev/null > /dev/tcp/${api_host}/${api_port}" 2>/dev/null; then
          break
        fi
        sleep 10
      done

      kubeadm join --config /opt/riid/kubeadm-join.yaml
      touch /run/riid-worker-ready

runcmd:
  - [bash, /opt/riid/bootstrap.sh]

output:
  all: "| tee -a /var/log/riid-bootstrap.log"
