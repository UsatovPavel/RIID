# Self-managed Ubuntu 22.04 stand for the Porto arm (AGENT-108).
# MKS cannot pick the node OS and lands on 24.04, where Porto has no packages,
# so this stand is built from plain cloud servers. Credentials come from
# deploy/k8s/config/.env through tf.sh, never from a tfvars file.

TF_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
K8S_ROOT := $(abspath $(TF_DIR)/../../../..)
CONFIG_YAML ?= $(K8S_ROOT)/config/config.yaml
# Separate from serverConfig.yaml on purpose: the MKS stand may exist at the
# same time and bootstrap/ must be pointed at one of them explicitly.
KUBECONFIG_OUT ?= $(abspath $(TF_DIR)/..)/serverConfig-porto.yaml
SSH_KEY ?= $(TF_DIR)/.ssh/id_ed25519
TF := $(TF_DIR)/tf.sh

# Same single source of truth as the MKS stand: cluster_topology in config.yaml.
NODES ?= $(shell yq -r '.cluster_topology.workers + .cluster_topology.observers + .cluster_topology.registry_nodes' "$(CONFIG_YAML)" 2>/dev/null)

export NODES

SSH_OPTS := -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR
NODE_READY_TIMEOUT ?= 1800

.PHONY: help init fmt validate plan apply destroy output stand stand-6 stand-12 \
        ssh-key kubeconfig wait ssh smoke nodes

help:
	@echo "make init          — download the openstack provider"
	@echo "make validate      — offline check of the configuration"
	@echo "make plan          — what would be created in Selectel (NODES=$(NODES))"
	@echo "make apply         — create the stand"
	@echo "make stand-6       — plan + apply + wait + kubeconfig on 6 workers"
	@echo "make stand-12      — the same on 12 workers"
	@echo "make kubeconfig    — write $(KUBECONFIG_OUT)"
	@echo "make wait          — block until every node is Ready"
	@echo "make smoke         — portoctl --version on every worker"
	@echo "make ssh           — shell on the control plane"
	@echo "make destroy       — delete the stand"

init:
	$(TF) init -input=false

fmt:
	$(TF) fmt -recursive

validate:
	$(TF) validate

plan:
	$(TF) plan -input=false -out=tfplan

apply:
	$(TF) apply -input=false tfplan

# `terraform destroy -input=false` without -auto-approve dies on "error asking
# for approval: EOF", so the stand is torn down through a saved plan, the same
# way it is created.
destroy:
	$(TF) plan -destroy -input=false -out=tfplan-destroy
	$(TF) apply -input=false tfplan-destroy

output:
	$(TF) output

# One button: everything from an empty project to a kubeconfig on disk.
stand:
	@$(MAKE) -C "$(TF_DIR)" init
	@$(MAKE) -C "$(TF_DIR)" plan
	@$(MAKE) -C "$(TF_DIR)" apply
	@$(MAKE) -C "$(TF_DIR)" kubeconfig
	@$(MAKE) -C "$(TF_DIR)" wait
	@$(MAKE) -C "$(TF_DIR)" smoke

stand-6:
	@$(MAKE) -C "$(TF_DIR)" stand NODES=6

stand-12:
	@$(MAKE) -C "$(TF_DIR)" stand NODES=12

# The keypair is generated by terraform, so the private half is extracted here
# rather than asked for. State already holds it; the file is gitignored.
ssh-key:
	@mkdir -p "$(dir $(SSH_KEY))"
	@umask 077 && $(TF) output -raw ssh_private_key > "$(SSH_KEY)"
	@chmod 600 "$(SSH_KEY)"

# kubeadm writes admin.conf pointing at the private address; the workstation
# reaches the API through the floating ip, so the server field is rewritten.
kubeconfig: ssh-key
	@ip="$$($(TF) output -raw control_plane_ip)"; \
	user="$$($(TF) output -raw ssh_user)"; \
	umask 077; \
	for attempt in $$(seq 1 60); do \
	  if ssh $(SSH_OPTS) -i "$(SSH_KEY)" "$$user@$$ip" 'sudo test -f /etc/kubernetes/admin.conf' 2>/dev/null; then break; fi; \
	  echo "waiting for kubeadm init on $$ip ($$attempt/60)"; sleep 20; \
	done; \
	ssh $(SSH_OPTS) -i "$(SSH_KEY)" "$$user@$$ip" 'sudo cat /etc/kubernetes/admin.conf' \
	  | sed -E "s#server: https://[^:]+:6443#server: https://$$ip:6443#" > "$(KUBECONFIG_OUT)"
	@echo "kubeconfig: $(KUBECONFIG_OUT)"

nodes:
	@KUBECONFIG="$(KUBECONFIG_OUT)" kubectl get nodes -o wide

# cloud-init ставит containerd, kubeadm и Porto на каждой ноде, поэтому первый
# boot длится минуты. Control plane отбрасывается селектором по
# наличию метки, а не по её значению: kubeadm ставит
# node-role.kubernetes.io/control-plane с пустым значением, и сравнение значения
# посчитало бы мастер обычным воркером.
wait:
	@[ -n "$(strip $(NODES))" ] || { echo "NODES is empty: install yq or pass NODES=6" >&2; exit 1; }
	@KUBECONFIG="$(KUBECONFIG_OUT)"; export KUBECONFIG; \
	[ -f "$$KUBECONFIG" ] || { echo "kubeconfig not found: $$KUBECONFIG (run make kubeconfig)" >&2; exit 1; }; \
	deadline=$$(( $$(date +%s) + $(NODE_READY_TIMEOUT) )); \
	while :; do \
	  ready=$$(kubectl get nodes --no-headers \
	    -l '!node-role.kubernetes.io/control-plane,!node-role.kubernetes.io/master' 2>/dev/null \
	    | awk '$$2 == "Ready"' | wc -l); \
	  echo "ready $$ready/$(NODES)"; \
	  [ "$$ready" -ge "$(NODES)" ] && break; \
	  [ "$$(date +%s)" -lt "$$deadline" ] || { echo "timeout waiting for nodes" >&2; exit 1; }; \
	  sleep 20; \
	done

ssh: ssh-key
	@ip="$$($(TF) output -raw control_plane_ip)"; \
	user="$$($(TF) output -raw ssh_user)"; \
	exec ssh $(SSH_OPTS) -i "$(SSH_KEY)" "$$user@$$ip"

# Workers carry no floating ip, so every check hops through the control plane.
smoke: ssh-key
	@ip="$$($(TF) output -raw control_plane_ip)"; \
	user="$$($(TF) output -raw ssh_user)"; \
	rc=0; \
	for w in $$($(TF) output -json worker_ips | python3 -c 'import json,sys; print(" ".join(json.load(sys.stdin)))'); do \
	  out=$$(ssh $(SSH_OPTS) -i "$(SSH_KEY)" -o ProxyCommand="ssh $(SSH_OPTS) -i $(SSH_KEY) -W %h:%p $$user@$$ip" \
	    "$$user@$$w" 'portoctl --version 2>&1 | head -1' 2>&1) || rc=1; \
	  printf '%-16s %s\n' "$$w" "$$out"; \
	done; \
	exit $$rc
