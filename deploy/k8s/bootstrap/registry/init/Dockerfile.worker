# Ubuntu Podman toolchain for RIID DaemonSet loaders / perf helpers — no RIID JAR here.
# Build from repo root: see init-worker-image.sh
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
# Cluster defaults; override via docker build --build-arg
ARG LOCAL_REGISTRY_HOST=local-registry.registry-system.svc.cluster.local:5000
ARG SELECTEL_REGISTRY_HOST=cr.selcloud.ru

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    coreutils \
    curl \
    fuse-overlayfs \
    iproute2 \
    jq \
    netcat-openbsd \
    podman \
    procps \
 && rm -rf /var/lib/apt/lists/*

# This image really does run podman inside the container (registry mirroring,
# dataset loads), so it keeps a fuse-overlayfs store of its own. The RIID pod no
# longer has one — its Java adapter talks directly to the node daemon's Unix
# socket — so the config lives here instead of being borrowed from src/riid/.
RUN printf '%s\n' \
      '[storage]' \
      'driver = "overlay"' \
      'runroot = "/var/run/containers/storage"' \
      'graphroot = "/var/lib/containers/storage"' \
      '' \
      '[storage.options.overlay]' \
      'mount_program = "/usr/bin/fuse-overlayfs"' \
      > /etc/containers/storage.conf

RUN mkdir -p /etc/containers/registries.conf.d \
 && printf '%s\n' \
      'unqualified-search-registries = ["docker.io"]' \
      > /etc/containers/registries.conf \
 && printf '%s\n' \
      '[[registry]]' \
      "location = \"${LOCAL_REGISTRY_HOST}\"" \
      'insecure = true' \
      '' \
      '[[registry]]' \
      "location = \"${SELECTEL_REGISTRY_HOST}\"" \
      > /etc/containers/registries.conf.d/10-riid-cluster-registries.conf

CMD ["sleep", "infinity"]
