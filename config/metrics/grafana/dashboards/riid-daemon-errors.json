        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum(rate(riid_daemon_pull_seconds_count[5m])) by (status_class)",
          "legendFormat": "{{status_class}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "POST /pull rate by HTTP class (2xx–5xx)",
      "type": "timeseries"
    },
