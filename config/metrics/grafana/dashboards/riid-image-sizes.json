  },
  "description": "Tar size bucket load counts, and successful pipeline latency p50/p95 per `category` (histogram of `riid_image.load`).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "description": "Successful loads with known tar size: `increase` count per `category` over the dashboard range. Uses **Bar chart** (not bar gauge) so all bars share one Y-axis from 0 to the global max count — avoids per-series max where every column looked 100% tall.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": true,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineWidth": 1,
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "decimals": 0,
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "barRadius": 0,
        "barWidth": 0.85,
        "fullHighlight": false,
        "groupWidth": 0.7,
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "none",
        "tooltip": { "mode": "single", "sort": "none" },
        "xField": "category",
        "xTickLabelMaxLength": 24,
        "xTickLabelRotation": 0
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "exemplar": false,
          "expr": "sum(increase(riid_image_load_tar_size_category_total[$__range])) by (category)",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Loads per tar size bucket (count in range; shared Y max)",
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "description": "Successful loads only (`result=success`), excluding `unknown` / `n_a`. Percentiles from Micrometer timer histogram (`riid_image_load_seconds_bucket`); aggregation window in query `[5m]` relative to each evaluation instant.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p50_s" },
            "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 }]
          },
          {
            "matcher": { "id": "byName", "options": "p95_s" },
            "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 11 },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "category" }]
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "exemplar": false,
          "expr": "histogram_quantile(0.50, sum(rate(riid_image_load_seconds_bucket{result=\"success\",category!~\"unknown|n_a\"}[5m])) by (le, category))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "exemplar": false,
          "expr": "histogram_quantile(0.95, sum(rate(riid_image_load_seconds_bucket{result=\"success\",category!~\"unknown|n_a\"}[5m])) by (le, category))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "B"
        }
      ],
      "title": "Load duration p50 / p95 by tar size bucket",
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "category", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true },
            "indexByName": {},
            "renameByName": {
              "Value #A": "p50_s",
              "Value #B": "p95_s"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["riid", "sizes"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
