# Local 3-node bench stand: one place for everything the scripts need.
# Override any of these in the environment before calling a script.

# VirtualBox VM names, in node order: control-plane first, then the workers.
STAND_VMS=${STAND_VMS:-"AI_Box AI_Box_2 AI_Box_3"}
STAND_NODES=${STAND_NODES:-"riid-n1 riid-n2 riid-n3"}
STAND_IPS=${STAND_IPS:-"192.168.56.11 192.168.56.12 192.168.56.13"}
# SSH aliases written into ~/.ssh/config by 01-host-prepare.sh.
STAND_SSH=${STAND_SSH:-"aibox aibox2 aibox3"}
STAND_SSH_PORTS=${STAND_SSH_PORTS:-"2222 2223 2224"}

STAND_USER=${STAND_USER:-ai}
# CLAUDE.md documents this password for the bench VMs; they are local scratch
# machines with no data of their own.
STAND_PASSWORD=${STAND_PASSWORD:-ai_password_const}

# Host-only network. Calico's default pool (192.168.0.0/16) would swallow this,
# which is why POD_CIDR below is deliberately not the Calico default.
STAND_HOSTONLY_NET=${STAND_HOSTONLY_NET:-192.168.56.0/24}
STAND_HOSTONLY_IF=${STAND_HOSTONLY_IF:-vboxnet0}
# NIC name inside the guest for the host-only adapter (second adapter).
STAND_CLUSTER_NIC=${STAND_CLUSTER_NIC:-enp0s8}

K8S_MINOR=${K8S_MINOR:-v1.34}
K8S_VERSION=${K8S_VERSION:-v1.34.11}
POD_CIDR=${POD_CIDR:-10.244.0.0/16}
CALICO_VERSION=${CALICO_VERSION:-v3.32.2}
# Docker is installed on these images, so cri-dockerd also exposes a CRI socket
# and kubeadm refuses to guess between them.
CRI_SOCKET=${CRI_SOCKET:-unix:///var/run/containerd/containerd.sock}

# Each VM: enough disk for the 20-image dataset (~20 GB unpacked) plus the
# ~6.3 GB kubelet keeps in reserve before it starts evicting pods.
VM_CPUS=${VM_CPUS:-5}
VM_MEMORY_MB=${VM_MEMORY_MB:-9000}
VM_DISK_MB=${VM_DISK_MB:-61440}

KUBECONFIG_OUT=${KUBECONFIG_OUT:-$HOME/.kube/riid-local.yaml}
